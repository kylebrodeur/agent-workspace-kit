    "builder": {
      "role": "Builder",
      "profile": ".pi-link/profiles/builder.md",
      "model": "example-model-large",
      "cwd": ".",
      "sessionDir": "sessions/builder",
      "linkName": "builder",
      "args": ["--no-lsp"],
      "skills": { "optional": ["team-workflow"] },
      "tools": { "required": ["read"] }
